{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "培养项目资料：学生、跨专业团队、课程阶段、展映渠道",
  "type": "object",
  "required": ["domain", "version", "cohort", "students", "teams", "stages", "channels"],
  "additionalProperties": false,
  "properties": {
    "domain": { "const": "ai-film-rights" },
    "version": { "type": "integer", "minimum": 1 },
    "cohort": {
      "type": "object",
      "required": ["id", "name", "started_on", "student_quota", "team_quota"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^co-" },
        "name": { "type": "string", "minLength": 1 },
        "started_on": { "type": "string", "format": "date" },
        "student_quota": { "type": "integer", "minimum": 1 },
        "team_quota": { "type": "integer", "minimum": 1 }
      }
    },
    "students": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/student" }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/team" }
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/stage" }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" }
    },
    "awards": {
      "type": "array",
      "items": { "$ref": "#/$defs/award" }
    }
  },
  "$defs": {
    "student": {
      "type": "object",
      "required": ["id", "code", "major", "team_id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^st-" },
        "code": { "type": "string", "minLength": 1, "description": "对内编号；真实姓名不入库" },
        "major": {
          "enum": ["导演", "编剧", "摄影", "美术", "表演", "动画", "声音设计", "音乐", "数字媒体", "人工智能", "法学", "市场营销"]
        },
        "team_id": { "type": ["string", "null"], "pattern": "^tm-" },
        "status": { "enum": ["在队", "已退出"] },
        "exited_on": { "type": ["string", "null"], "format": "date" },
        "exit_note": { "type": ["string", "null"] }
      }
    },
    "team": {
      "type": "object",
      "required": ["id", "name", "city_brief", "members"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^tm-" },
        "name": { "type": "string", "minLength": 1 },
        "city_brief": { "type": "string", "minLength": 1, "description": "城市命题（命题创作阶段抽中的城市与题面）" },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["student_id", "role", "joined_on"],
            "additionalProperties": false,
            "properties": {
              "student_id": { "type": "string", "pattern": "^st-" },
              "role": { "enum": ["导演", "编剧", "摄影", "美术", "表演", "动画", "声音", "作曲", "技术", "制片", "法务联络"] },
              "joined_on": { "type": "string", "format": "date" },
              "left_on": { "type": ["string", "null"], "format": "date" },
              "contribution": { "type": "string", "description": "该成员对作品的可追溯贡献说明，退出后仍保留" }
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "key", "name", "order", "window_start", "window_end"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^sg-" },
        "key": { "enum": ["training", "city_brief", "blind_review", "showcase", "incubation"] },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "window_start": { "type": "string", "format": "date" },
        "window_end": { "type": "string", "format": "date" },
        "anonymized": { "type": "boolean", "description": "盲评阶段为 true：不得出现院校与作者身份信息" }
      }
    },
    "channel": {
      "type": "object",
      "required": ["id", "name", "kind", "purposes", "regions", "commercial", "requires_anonymity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ch-" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["课堂展映", "城市嘉年华", "就业对接", "商业推广", "孵化路演", "影展投递"] },
        "purposes": {
          "type": "array",
          "items": { "enum": ["课堂教学", "非商业展映", "商业展映", "商业推广", "招聘评审", "融资路演", "影展参评"] },
          "minItems": 1
        },
        "regions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "commercial": { "type": "boolean" },
        "requires_anonymity": { "type": "boolean", "description": "渠道是否要求盲评式匿名（如评选期内的影展）" }
      }
    },
    "award": {
      "type": "object",
      "required": ["id", "name", "work_id", "stage_id", "won_on", "license_scope_note"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^aw-" },
        "name": { "type": "string" },
        "work_id": { "type": "string", "pattern": "^wk-" },
        "stage_id": { "type": "string", "pattern": "^sg-" },
        "won_on": { "type": "string", "format": "date" },
        "license_scope_note": {
          "type": "string",
          "description": "明示：获奖仅扩大展映荣誉，不自动把课堂许可扩展为商业推广"
        }
      }
    }
  }
}
