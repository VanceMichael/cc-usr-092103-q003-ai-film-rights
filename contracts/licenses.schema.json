{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "素材许可",
  "type": "object",
  "required": ["domain", "kind", "version", "licenses"],
  "properties": {
    "domain": { "const": "ai-film-rights" },
    "kind": { "const": "licenses" },
    "version": { "type": "integer", "minimum": 1 },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "licensor", "purposes", "territories", "term", "revocation"],
        "properties": {
          "id": { "type": "string", "pattern": "^lic-" },
          "licensor": {
            "type": "object",
            "required": ["id", "name", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["vendor", "musician", "dataset", "archive", "collective", "student"] }
            },
            "additionalProperties": false
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["classroom", "festival", "job_matching", "commercial"] },
            "description": "许可用途：课堂 / 展映 / 就业对接 / 商业推广"
          },
          "territories": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "许可地域，global 表示全球"
          },
          "term": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "additionalProperties": false
          },
          "revocation": {
            "type": "object",
            "required": ["revocable", "notice_days", "status", "revoked_at", "reason"],
            "properties": {
              "revocable": { "type": "boolean" },
              "notice_days": { "type": "integer", "minimum": 0 },
              "status": { "enum": ["active", "revoked"] },
              "revoked_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "reason": { "type": ["string", "null"] }
            },
            "additionalProperties": false,
            "if": { "properties": { "status": { "const": "revoked" } } },
            "then": { "required": ["revoked_at", "reason"] }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
