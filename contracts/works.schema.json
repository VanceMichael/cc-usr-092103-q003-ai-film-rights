{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "作品、派生版本、声明与贡献",
  "type": "object",
  "required": ["domain", "kind", "version", "works", "versions", "declarations", "contributions"],
  "properties": {
    "domain": { "const": "ai-film-rights" },
    "kind": { "const": "works" },
    "version": { "type": "integer", "minimum": 1 },
    "works": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "team_id", "title", "stage", "award"],
        "properties": {
          "id": { "type": "string", "pattern": "^work-" },
          "team_id": { "type": "string", "pattern": "^team-\\d{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["training", "city_brief", "blind_review", "screening", "incubation"] },
          "award": {
            "type": ["object", "null"],
            "required": ["name", "granted_at"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "granted_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            },
            "additionalProperties": false,
            "description": "获奖记录只作事实登记，不扩展任何许可范围"
          }
        },
        "additionalProperties": false
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "work_id", "parent_id", "seq", "created_by", "created_at", "visibility", "asset_uses"],
        "properties": {
          "id": { "type": "string", "pattern": "^ver-" },
          "work_id": { "type": "string", "pattern": "^work-" },
          "parent_id": { "type": ["string", "null"], "pattern": "^ver-", "description": "派生自哪个版本，null 为根版本" },
          "seq": { "type": "integer", "minimum": 1 },
          "created_by": { "type": "string", "pattern": "^stu-\\d{3}$" },
          "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "visibility": { "enum": ["internal", "public"] },
          "asset_uses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["asset_id", "role"],
              "properties": {
                "asset_id": { "type": "string", "pattern": "^asset-" },
                "role": { "enum": ["cast", "soundtrack", "training", "footage"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version_id", "declared_by", "declared_at", "asset_ids"],
        "properties": {
          "id": { "type": "string", "pattern": "^decl-" },
          "version_id": { "type": "string", "pattern": "^ver-" },
          "declared_by": { "type": "string", "pattern": "^stu-\\d{3}$" },
          "declared_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "asset_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^asset-" },
            "description": "团队声明该版本使用的全部素材，漏报即阻断"
          }
        },
        "additionalProperties": false
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["student_id", "version_id", "role", "hours", "recorded_at"],
        "properties": {
          "student_id": { "type": "string", "pattern": "^stu-\\d{3}$" },
          "version_id": { "type": "string", "pattern": "^ver-" },
          "role": { "type": "string", "minLength": 1 },
          "hours": { "type": "number", "exclusiveMinimum": 0 },
          "recorded_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false,
        "description": "贡献记录永久保留，成员退出不抹除"
      }
    }
  },
  "additionalProperties": false
}
