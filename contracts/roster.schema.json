{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "学生与团队名册",
  "type": "object",
  "required": ["domain", "kind", "version", "stages", "students", "teams"],
  "properties": {
    "domain": { "const": "ai-film-rights" },
    "kind": { "const": "roster" },
    "version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["training", "city_brief", "blind_review", "screening", "incubation"] }
    },
    "students": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "major", "institution", "team_id", "status", "enrolled_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^stu-\\d{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "major": { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "team_id": { "type": "string", "pattern": "^team-\\d{2}$" },
          "status": { "enum": ["active", "withdrawn"] },
          "enrolled_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "withdrawn_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false,
        "if": { "properties": { "status": { "const": "withdrawn" } } },
        "then": { "required": ["withdrawn_at"] }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "member_ids", "majors"],
        "properties": {
          "id": { "type": "string", "pattern": "^team-\\d{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "member_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "pattern": "^stu-\\d{3}$" }
          },
          "majors": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 },
            "description": "跨专业团队：至少覆盖两个专业"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
